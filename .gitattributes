# Line endings stay LF on every platform (the tests compare exact bytes).
* text=auto eol=lf

# Upstream copies are kept byte for byte.
/openapi/*.json -text

# Generated code: collapsed in pull request diffs.
/src/Resources/** linguist-generated=true
/src/Types/** linguist-generated=true
/src/DiditClient.php linguist-generated=true
/src/Params.php linguist-generated=true
/tests/Generated/** linguist-generated=true

# Not part of the package Composer installs.
/.github export-ignore
/codegen export-ignore
/docs export-ignore
/examples export-ignore
/openapi export-ignore
/tests export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.gitleaks.toml export-ignore
/.php-cs-fixer.dist.php export-ignore
/.release-please-manifest.json export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/CONTRIBUTING.md export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
/release-please-config.json export-ignore
