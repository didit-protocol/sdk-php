{
    "name": "didit-protocol/sdk-php",
    "description": "The official Didit PHP library: identity verification (KYC), business verification (KYB), AML screening, liveness, transaction monitoring, Travel Rule and customer authentication.",
    "type": "library",
    "keywords": [
        "didit",
        "identity verification",
        "kyc",
        "kyb",
        "aml",
        "liveness",
        "transaction monitoring",
        "travel rule",
        "sdk",
        "api"
    ],
    "homepage": "https://didit.me",
    "license": "MIT",
    "authors": [
        {
            "name": "Didit",
            "email": "support@didit.me",
            "homepage": "https://didit.me"
        }
    ],
    "support": {
        "email": "support@didit.me",
        "docs": "https://docs.didit.me",
        "issues": "https://github.com/didit-protocol/sdk-php/issues",
        "source": "https://github.com/didit-protocol/sdk-php",
        "security": "https://github.com/didit-protocol/sdk-php/security/policy"
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.8",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.5",
        "symfony/http-client": "^6.4 || ^7.0"
    },
    "suggest": {
        "ext-openssl": "Required by Didit\\Authentication to verify ES256 access and ID tokens.",
        "guzzlehttp/guzzle": "The recommended PSR-18 HTTP client; the SDK applies its timeouts natively.",
        "symfony/http-client": "An alternative PSR-18 HTTP client; the SDK applies its timeouts natively from version 6.2."
    },
    "autoload": {
        "psr-4": {
            "Didit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Didit\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "scripts": {
        "generate": "python3 codegen/generate.py",
        "generate:check": "python3 codegen/generate.py --check",
        "test": "phpunit",
        "test:live": "phpunit --testsuite live",
        "analyse": "phpstan analyse --memory-limit=-1",
        "lint": "php-cs-fixer check --diff",
        "lint:fix": "php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
