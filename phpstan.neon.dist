includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    phpVersion:
        min: 80100
        max: 80499
    paths:
        - src
        - tests
        - examples
    tmpDir: .phpstan.cache
    # BaseClient::initialize() and the generated initResources() run once, from the constructor or fromRequester().
    additionalConstructors:
        - Didit\Core\BaseClient::initialize
        - Didit\Core\BaseClient::initResources
